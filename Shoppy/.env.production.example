# ─────────────────────────────────────────────────────────────────────────────
# Template de producción de vinta.zhe (SIN secretos reales).
# Copiar a `.env.production` (ignorado por git) y rellenar los valores.
#   cp .env.production.example .env.production
# Subir a Vercel:  ./scripts/setup-vercel-env.sh .env.production production
# Subir a Supabase (Edge Functions secrets): ver docs/GO-LIVE.md §2
# ─────────────────────────────────────────────────────────────────────────────

# ── App / dominio ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vintah.net
NEXT_PUBLIC_SUPABASE_URL=https://evzlqwiipdjgtrqjlwba.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Pagos (MercadoPago LIVE) ─────────────────────────────────────────────────
# Pegar credenciales PRODUCTIVAS (APP_USR-...) tras aprobar el KYC.
PAYMENT_PROVIDER=mercadopago
PAYMENT_PROVIDERS=mercadopago
PAYMENT_MODE=live
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública de las Edge Functions (para notification_url de MP).
FUNCTIONS_PUBLIC_URL=https://evzlqwiipdjgtrqjlwba.supabase.co/functions/v1

# ── Emails transaccionales (Resend) ──────────────────────────────────────────
# El código ya soporta los 7 eventos; solo falta activar el proveedor.
EMAIL_PROVIDER=resend
EMAIL_FROM=vinta.zhe <pedidos@vintah.net>
RESEND_API_KEY=
# En modo live se envían a cualquier destinatario; en sandbox solo a esta lista.
# Dejar vacío en producción.
EMAIL_TEST_RECIPIENTS=

# ── Envíos (tarifas administrables; default manual) ──────────────────────────
DEFAULT_SHIPPING_PROVIDER=manual
SHIPPING_PROVIDER=manual
# Carrier en vivo (opcional; requiere homologación — ver docs/GO-LIVE.md §5).
CHILEXPRESS_API_KEY=
STARKEN_API_KEY=

# ── Supabase (solo server-side / Edge Functions; NUNCA exponer) ──────────────
SUPABASE_SERVICE_ROLE_KEY=

# ── IA de autocompletado (Gemini visión, capa gratis) ────────────────────────
GEMINI_API_KEY=
