# ─── Supabase (compartido) ───
# URL pública del proyecto Supabase. Se expone al cliente vía EXPO_PUBLIC_ / NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA exponer service_role en mobile/admin cliente. Solo Edge Functions / scripts server-side.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Mobile (Expo) ───
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
# Opcional: URL de la API admin/backend si se usa en desarrollo
EXPO_PUBLIC_API_URL=http://localhost:3000

# ─── Admin (Next.js) ───
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ─── Pagos (diseño desacoplado, sandbox por defecto) ───
# Valores posibles: mock | mercadopago | transbank
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDERS=mock
PAYMENT_MODE=sandbox
# Origen HTTPS del administrador, sin /api/payments al final.
PAYMENT_BRIDGE_URL=
# Mercado Pago (dashboard → Tus integraciones → credenciales + webhook secret)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Transbank Webpay Plus (LIVE exige credenciales productivas reales)
TRANSBANK_ENVIRONMENT=TEST
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY_SECRET=
# URL pública de las Edge Functions (para notification_url de MP)
FUNCTIONS_PUBLIC_URL=
# URL de retorno en la app tras pagar en el proveedor (deep link)
# return_url por defecto: shopy://checkout-return (ver app.json scheme)

# ─── Email (desacoplado, mock/log por defecto) ───
# Valores posibles: mock | brevo | smtp2go | resend
# brevo y smtp2go verifican solo el remitente (sin dominio propio) y tienen plan $0.
EMAIL_PROVIDER=mock
EMAIL_FROM=
# Destinatarios de prueba autorizados, separados por comas.
EMAIL_TEST_RECIPIENTS=
BREVO_API_KEY=
SMTP2GO_API_KEY=
# resend exige un dominio verificado.
RESEND_API_KEY=

# ─── Shipping (tarifas administrables en MVP) ───
# Valores posibles: manual | chilexpress | starken
DEFAULT_SHIPPING_PROVIDER=manual
SHIPPING_PROVIDER=manual
# Carriers en vivo (Fase 9+ con homologación; sin URLs inventadas en código)
CHILEXPRESS_API_KEY=
STARKEN_API_KEY=
