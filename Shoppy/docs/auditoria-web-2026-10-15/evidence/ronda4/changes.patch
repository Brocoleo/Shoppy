+
+/* La composición editorial mantiene texto y fotografías en el HTML inicial. */
+.editorial-hero { position: relative; display: grid; grid-template-columns: 1.12fr 1fr; min-height: 650px; isolation: isolate; }
+.editorial-copy { z-index: 2; align-self: start; padding-top: clamp(65px, 9vw, 125px); padding-right: 16px; }
+.editorial-title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(3.5rem, 6.25vw, 5.8rem); line-height: .98; letter-spacing: -.065em; text-wrap: nowrap; }
+.editorial-title span, .editorial-title em { display: block; }
+.editorial-title em { font-weight: 400; }
+.editorial-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 38px; min-height: 44px; border-bottom: 1px solid currentColor; font-size: 14px; }
+.editorial-link span { font-size: 25px; transition: transform 220ms var(--ease-standard); }
+.editorial-link:hover span { transform: translateX(5px); }
+.editorial-action { margin-top: 42px; }
+.editorial-main-photo { position: relative; min-height: 650px; background: var(--color-parchment); }
+.editorial-secondary-photo { position: absolute; width: 23%; height: 310px; left: 35%; bottom: 0; z-index: 3; background: var(--color-parchment); }
+@media (min-width: 768px) and (max-width: 1023px) {
+ .editorial-hero, .editorial-main-photo { min-height: 540px; }
+ .editorial-title { font-size: 5.8vw; }
+ .editorial-secondary-photo { height: 230px; }
+}
+@media (max-width: 767px) {
+ .editorial-hero { display: flex; flex-direction: column; min-height: 0; }
+ .editorial-copy { padding: 22px 0 28px; }
+ .editorial-title { font-size: clamp(2.4rem, 10.7vw, 4.9rem); line-height: 1.02; letter-spacing: -.06em; }
+ .editorial-action { margin-top: 20px; }
+ .editorial-main-photo { width: 100%; min-height: 0; height: clamp(300px, 96vw, 530px); }
+ .editorial-main-photo img { object-position: center 30%; }
+ .editorial-secondary-photo { display: none; }
+}
+@media (prefers-reduced-motion: no-preference) {
+ .editorial-title span { animation: editorial-enter 600ms var(--ease-entrance) both; }
+ .editorial-title em { animation: editorial-enter 600ms 70ms var(--ease-entrance) both; }
+ .editorial-action { animation: editorial-enter 500ms 140ms var(--ease-entrance) both; }
+ .editorial-main-photo { animation: editorial-enter 600ms 100ms var(--ease-entrance) both; }
+ .editorial-secondary-photo { animation: editorial-enter 500ms 200ms var(--ease-entrance) both; }
+}
+@keyframes editorial-enter { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
