+"use client";
+
+import Link from "next/link";
+import { useQuery } from "@tanstack/react-query";
+import {
+  getCollection,
+  getProductsByIds,
+  listBrands,
+  listCategories,
+  listProducts,
+} from "../lib/catalog";
+import { EditorialHero } from "./EditorialHero";
+import { Reveal } from "./Reveal";
+import { ProductGrid, ProductGridSkeleton } from "./ProductCard";
+import { ErrorState, SectionTitle, backendErrorMessage } from "./States";
+import { isSupabaseConfigured } from "../lib/supabase";
+
+export default function HomeContent({ initialProducts }: { initialProducts?: import("../lib/catalog").CatalogProduct[] }) {
+  const newcomers = useQuery({ queryKey: ["web", "products", "novedades"], queryFn: () => listProducts("novedades"), initialData: initialProducts, enabled: isSupabaseConfigured });
+  const trending = useQuery({ queryKey: ["web", "products", "tendencia"], queryFn: () => listProducts("tendencia"), enabled: isSupabaseConfigured });
+  const categories = useQuery({ queryKey: ["web", "categories"], queryFn: listCategories, enabled: isSupabaseConfigured });
+  const brands = useQuery({ queryKey: ["web", "brands"], queryFn: listBrands, enabled: isSupabaseConfigured });
+  const offers = useQuery({ queryKey: ["web", "collection", "ofertas"], queryFn: () => getCollection("ofertas"), enabled: isSupabaseConfigured });
+
+  const offerIds = [...new Set(offers.data?.productIds ?? [])].slice(0, 8);
+  const offerKey = offerIds.join(",");
+  const offerProducts = useQuery({
+    queryKey: ["web", "products-by-ids", offerKey],
+    queryFn: () => getProductsByIds(offerIds),
+    enabled: isSupabaseConfigured && offerIds.length > 0,
+  });
+
+  if (!isSupabaseConfigured) {
+    return <ErrorState message="La tienda no está disponible en este momento. Vuelve a intentarlo más tarde." />;
+  }
+  const withImage = (newcomers.data ?? []).find((p) => (p.remoteImages ?? []).some((i) => !i.isDefect));
+  const hero = withImage ?? newcomers.data?.[0] ?? trending.data?.[0];
+  const parents = (categories.data ?? []).filter((c) => c.parentSlug === null);
+  const topBrands = (brands.data ?? []).slice(0, 8);
+
+  return (
+    <div className="flex flex-col gap-6 sm:gap-10 md:gap-12">
+      <EditorialHero product={hero} />
+
+      <nav aria-label="Categorías" className="flex min-h-24 flex-wrap content-start gap-2 sm:min-h-12">
+        {categories.isPending ? Array.from({ length: 5 }, (_, index) => (
+          <span key={index} aria-hidden="true" className="shimmer h-11 w-20 animate-shimmer rounded-full" />
+        )) : parents.map((category) => (
+          <Link key={category.slug} href={`/catalogo?categoria=${encodeURIComponent(category.slug)}`} className="inline-flex min-h-11 items-center rounded-full border border-carbon/25 px-5 text-sm text-carbon transition-colors hover:border-carbon hover:bg-carbon hover:text-ivory">
+            {category.name}
+          </Link>
+        ))}
+      </nav>
+
+      <Reveal>
+        <section aria-labelledby="novedades-titulo">
+        <SectionTitle
+          title="Novedades"
+          id="novedades-titulo"
+          action={
+            <Link href="/catalogo?orden=novedades" className="text-sm text-muted underline underline-offset-4 hover:text-carbon">
+              Ver novedades
+            </Link>
+          }
+        />
+        {newcomers.isPending ? <ProductGridSkeleton /> : newcomers.isError ? (
+          <ErrorState message={backendErrorMessage()} onRetry={() => newcomers.refetch()} />
+        ) : <ProductGrid products={(newcomers.data ?? []).slice(0, 8)} />}
+        </section>
+      </Reveal>
+
+      {offerProducts.data && offerProducts.data.length > 0 ? (
+        <Reveal>
+          <section aria-labelledby="ofertas-titulo" className="bg-parchment p-4 sm:p-8">
+          <SectionTitle
+            title={offers.data?.name ?? "Ofertas"}
+            id="ofertas-titulo"
+            action={
+              <Link href="/coleccion/ofertas" className="text-sm text-muted underline underline-offset-4 hover:text-carbon">
+                Ver colección
+              </Link>
+            }
+          />
+          <ProductGrid products={offerProducts.data} />
+          </section>
+        </Reveal>
+      ) : null}
+
+      <Reveal>
+        <section aria-labelledby="tendencia-titulo">
+        <SectionTitle title="Tendencia" id="tendencia-titulo" />
+        {trending.isPending ? <ProductGridSkeleton /> : trending.isError ? (
+          <ErrorState message={backendErrorMessage()} onRetry={() => trending.refetch()} />
+        ) : <ProductGrid products={(trending.data ?? []).slice(0, 8)} />}
+        </section>
+      </Reveal>
+
+      {topBrands.length > 0 ? (
+        <Reveal>
+          <section aria-labelledby="marcas-titulo">
+          <SectionTitle title="Marcas" id="marcas-titulo" />
+          <ul className="flex flex-wrap gap-2">
+            {topBrands.map((b) => (
+              <li key={b.slug}>
+                <Link
+                  href={`/catalogo?marca=${encodeURIComponent(b.slug)}`}
+                  className="inline-flex min-h-11 items-center border border-carbon/30 px-4 py-1.5 text-sm text-carbon transition-colors hover:bg-carbon hover:text-ivory"
+                >
+                  {b.name}
+                </Link>
+              </li>
+            ))}
+          </ul>
+          </section>
+        </Reveal>
+      ) : null}
+    </div>
+  );
+}
